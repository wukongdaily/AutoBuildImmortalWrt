# ImmortalWrt x86-64 源码编译 seed config
# 仅包含需要显式指定的选项，其余由 make defconfig 自动补全

# 内核版本
CONFIG_LINUX_6_12=y

# 编译目标
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=y
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y

# 固件格式：只需要 EFI squashfs
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_EFI_IMAGES=y
# 根分区大小由 workflow 动态注入 CONFIG_TARGET_ROOTFS_PARTSIZE

# ── 基础工具 ──────────────────────────────────────────────────
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ── LuCI 界面 & 主题 ──────────────────────────────────────────
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ── 代理 ──────────────────────────────────────────────────────
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y

# ── MLX4 / MLX5 网卡驱动 ──────────────────────────────────────
CONFIG_PACKAGE_kmod-mlx4-core=y
CONFIG_PACKAGE_kmod-mlx5-core=y

# ── TC 硬件分流依赖模块 ───────────────────────────────────────
# cls_flower: 硬件 flower 分类器，mlx5 hw-tc-offload 的核心入口
CONFIG_PACKAGE_kmod-sched-flower=y
# act_ct: 连接跟踪 TC action，配合 mlx5 CT offload
CONFIG_PACKAGE_kmod-sched-act-ct=y
# tc 调度框架
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched=y
# tc 用户态完整工具
CONFIG_PACKAGE_tc-full=y

# ── nftables flow offload（软件分流兜底） ─────────────────────
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y
